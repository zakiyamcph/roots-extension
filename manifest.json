{
  "manifest_version": 3,
  "name": "Roots — Arabic Root & Form Visualizer",
  "version": "0.1.0",
  "description": "Understand non-vocalized Arabic web text: hover any verb for its trilateral root and form, toggle diacritics, and spot advanced vocabulary with a frequency heatmap.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Roots — toggle on this page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "options_page": "src/options/options.html",
  "web_accessible_resources": [
    {
      "resources": ["src/content/content.css", "src/data/lexicon.json", "src/data/frequency.json"],
      "matches": ["<all_urls>"]
    }
  ]
}
